{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tracker",
  "version": "0.1.6",
  "identifier": "dev.pponikiewski.tracker",
  "build": {
    "beforeDevCommand": "corepack pnpm@10 dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm@10 build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tracker",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; font-src 'self' data:; connect-src 'self' http://localhost:1420 ws://localhost:1421 https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "pponikiewski",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RTRDNTA2NTU2QTY5QUQKUldTdGFXcFZCc1hrVllaYlNrWGIyUjhZMG5iNlExQXFQem9xb29XRkxQenVYNnZadGYrVHpNL3UK",
      "endpoints": ["https://github.com/pponikiewski/tracker/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
